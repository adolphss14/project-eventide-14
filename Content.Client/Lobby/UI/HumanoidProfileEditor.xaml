<BoxContainer xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
         xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
         HorizontalExpand="True">
        <!-- Left side -->
        <BoxContainer Orientation="Vertical" Margin="10 10 10 10" HorizontalExpand="True">
            <!-- Middle container -->
            <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True">
                <!-- Name box-->
                <BoxContainer Orientation="Vertical">
                    <ui:HighlightedContainer>
                        <BoxContainer Orientation="Vertical">
                            <BoxContainer Orientation="Horizontal" VerticalExpand="True">
                                <Label Text="{Loc 'humanoid-profile-editor-name-label'}" />
                                <LineEdit Name="NameEdit" MinSize="245 0" VerticalAlignment="Center" Margin="5 0 0 0" />
                                <Button Name="RandomizeNameButton"
                                        Text="{Loc 'humanoid-profile-editor-randomize-name-button'}"
                                        ToolTip="{Loc 'humanoid-profile-editor-randomize-name-now-tooltip'}"
                                        Margin="5 0 0 0" />
                            </BoxContainer>
                            <RichTextLabel Name="WarningLabel" HorizontalExpand="False"
                                            VerticalExpand="True" MaxWidth="425"
                                            HorizontalAlignment="Left" />
                        </BoxContainer>
                    </ui:HighlightedContainer>
                </BoxContainer>
                <!-- Randomizer -->
                <BoxContainer Orientation="Vertical">
                    <ui:HighlightedContainer>
                        <BoxContainer Orientation="Vertical">
                            <Label Text="{Loc 'humanoid-profile-editor-randomize'}" HorizontalAlignment="Center"/>
                            <controls:Separator StyleClasses="LowDivider" Margin="0 10"/>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                                <Button Name="RandomizeUnlockedButton" HorizontalExpand="True"
                                    Text="{Loc 'humanoid-profile-editor-randomize-unlocked-button'}"/>
                                <Button Name="RandomizeSettingsButton" Text="⚙"
                                    ToolTip="{Loc 'humanoid-profile-editor-randomizer-settings-tooltip'}"/>
                            </BoxContainer>
                            <ScrollContainer Name="RandomizationSettingsPanel" Visible="False"
                                HorizontalExpand="True" MinSize="0 180" MaxSize="0 360">
                                <BoxContainer Orientation="Vertical" Margin="0 6 0 0" HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-randomizer-name-settings'}" FontSize="16"/>
                                    <GridContainer Columns="2" HorizontalExpand="True">
                                        <CheckBox Name="RandomizeFirstNameCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-randomize-first-name'}"/>
                                        <CheckBox Name="RandomizeLastNameCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-randomize-last-name'}"/>
                                    </GridContainer>
                                    <controls:Separator StyleClasses="LowDivider" Margin="0 6"/>
                                    <Label Text="{Loc 'humanoid-profile-editor-randomizer-appearance-settings'}" FontSize="16"/>
                                    <GridContainer Columns="2" HorizontalExpand="True">
                                        <CheckBox Name="RandomizeSpeciesCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-randomize-species-button'}"/>
                                        <CheckBox Name="RandomizeAgeCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-randomize-age-button'}"/>
                                        <CheckBox Name="RandomizeSexCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-sex-label'}"/>
                                        <CheckBox Name="RandomizeGenderCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-pronouns-label'}"/>
                                        <CheckBox Name="RandomizeSkinCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-skin-color-label'}"/>
                                        <CheckBox Name="RandomizeEyesCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-eyes-label'}"/>
                                        <CheckBox Name="RandomizeMarkingsCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-randomize-markings-button'}"/>
                                    </GridContainer>
                                    <Label Text="{Loc 'humanoid-profile-editor-randomizer-marking-layers'}" FontSize="14"/>
                                    <GridContainer Name="RandomizeMarkingLayersContainer" Columns="2" HorizontalExpand="True" />
                                    <controls:Separator StyleClasses="LowDivider" Margin="0 6"/>
                                    <Label Text="{Loc 'humanoid-profile-editor-randomizer-preferences-settings'}" FontSize="16"/>
                                    <GridContainer Columns="2" HorizontalExpand="True">
                                        <CheckBox Name="RandomizeJobsCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-jobs-tab'}"/>
                                        <CheckBox Name="RandomizeAntagsCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-antags-tab'}"/>
                                        <CheckBox Name="RandomizeTraitsCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-traits-tab'}"/>
                                        <CheckBox Name="RandomizeLoadoutsCheckBox"
                                                  Text="{Loc 'humanoid-profile-editor-randomize-loadouts-button'}"/>
                                    </GridContainer>
                                    <CheckBox Name="ConsiderClothingCheckBox"
                                              Text="{Loc 'humanoid-profile-editor-randomizer-consider-clothing'}"/>
                                    <Label Text="{Loc 'humanoid-profile-editor-randomizer-clothing-style'}"/>
                                    <OptionButton Name="ClothingStyleButton" Visible="False" HorizontalExpand="True"/>
                                    <Label Text="{Loc 'humanoid-profile-editor-randomizer-uniform-style'}"/>
                                    <OptionButton Name="UniformStyleButton" Visible="False" HorizontalExpand="True"/>
                                </BoxContainer>
                            </ScrollContainer>
                        </BoxContainer>
                    </ui:HighlightedContainer>
                </BoxContainer>
                <!-- Import/Export -->
                <BoxContainer Orientation="Vertical" MinSize="60 0" HorizontalExpand="True" HorizontalAlignment="Right">
                    <ui:HighlightedContainer Name="ProfileHighlight">
                        <BoxContainer Orientation="Vertical">
                            <Button Name="SaveButton" Text="{Loc 'humanoid-profile-editor-save-button'}"/>
                            <Button Name="ResetButton" Disabled="True" Text="{Loc 'humanoid-profile-editor-reset-button'}"/>
                            <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}"/>
                            <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}"/>
                            <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}"/>
                            <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}"/>
                        </BoxContainer>
                    </ui:HighlightedContainer>
                </BoxContainer>
            </BoxContainer>
            <Control MinHeight="10" />
            <!-- tabContainer -->
            <TabContainer Name="TabContainer" VerticalExpand="True">
                <BoxContainer Orientation="Vertical">
                    <ScrollContainer VerticalExpand="True">
                        <!-- appearanceList -->
                        <BoxContainer Orientation="Vertical">
                            <BoxContainer Margin="10" Orientation="Vertical" HorizontalExpand="True">
                                <!-- Species -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-species-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}"/>
                                    <OptionButton Name="SpeciesButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Age -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-age-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <LineEdit Name="AgeEdit" MinSize="60 0" HorizontalAlignment="Right" /> <!-- Corvax-SpeciesAgeLore -->
                                </BoxContainer>
                                <!-- Sex -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <OptionButton Name="SexButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Voice -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-voice-label'}" />
                                    <Control HorizontalExpand="True" />
                                    <OptionButton Name="VoiceButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Pronouns -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <OptionButton Name="PronounsButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Show clothing -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-clothing'}" />
                                    <Control HorizontalExpand="True"/>
                                    <Button Name="ShowClothes" Pressed="True" ToggleMode="True" Text="{Loc 'humanoid-profile-editor-clothing-show'}" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Spawn Priority -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <OptionButton Name="SpawnPriorityButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                            </BoxContainer>
                            <!-- Skin -->
                            <BoxContainer Margin="10" HorizontalExpand="True" Orientation="Vertical">
                                <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                                <Slider HorizontalExpand="True" Name="Skin" MinValue="0" MaxValue="100" Value="20" />
                                <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True"></BoxContainer>
                            </BoxContainer>
                            <!-- Eyes -->
                            <BoxContainer Margin="10" Orientation="Vertical">
                                <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" />
                                <humanoid:EyeColorPicker Name="EyeColorPicker" />
                            </BoxContainer>
                        </BoxContainer>
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical">
                    <!-- Jobs -->
                    <OptionButton Name="PreferenceUnavailableButton" />
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="JobList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" Margin="10">
                    <!-- Antags -->
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="AntagList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" Margin="10">
                    <!-- Traits -->
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="TraitsList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Name="MarkingsTab" Orientation="Vertical" Margin="10">
                    <!-- Markings -->
                    <humanoid:MarkingPicker Name="Markings" HorizontalExpand="True" VerticalExpand="True" />
                </BoxContainer>
            </TabContainer>
        </BoxContainer>
        <!-- Right side -->
        <BoxContainer Orientation="Vertical" VerticalExpand="True" VerticalAlignment="Center">
            <profile:ProfilePreviewSpriteView Name="SpriteView" Scale="8 8" Margin="4" SizeFlagsStretchRatio="1" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5">
                <Button Name="SpriteRotateLeft" Text="◀" StyleClasses="OpenRight" />
                <controls:Separator StyleClasses="LowDivider" Margin="2 0 3 0" Orientation="Vertical" MinHeight="5"/>
                <Button Name="SpriteRotateRight" Text="▶" StyleClasses="OpenLeft" />
            </BoxContainer>
        </BoxContainer>
</BoxContainer>
