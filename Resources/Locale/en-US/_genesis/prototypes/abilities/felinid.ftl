# Felinid ability messages
hairball-mask = Your { $mask } prevents you from coughing up a hairball.
hairball-cough = { $name } coughs up a hairball.

# Wound licking
lick-wounds-yourself-impossible = You cannot lick your own wounds.
lick-wounds-other-impossible = You cannot lick other people's wounds.
lick-wounds-yourself-no-wounds = You do not have any wounds to lick.
lick-wounds-performer-no-wounds = { $target } has no wounds to lick.
lick-wounds-yourself-begin = You begin licking your wounds.
lick-wounds-yourself-other-begin = { $performer } begins licking their wounds.
lick-wounds-performer-begin = You begin licking { $target }'s wounds.
lick-wounds-target-begin = { $performer } begins licking your wounds.
lick-wounds-other-begin = { $performer } begins licking { $target }'s wounds.
lick-wounds-yourself-success = You lick your wounds.
lick-wounds-yourself-other-success = { $performer } licks their wounds.
lick-wounds-performer-success = You lick { $target }'s wounds.
lick-wounds-target-success = { $performer } licks your wounds.
lick-wounds-other-success = { $performer } licks { $target }'s wounds.
